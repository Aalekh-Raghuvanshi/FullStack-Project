generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PATIENT
}

enum DoctorAvailability {
  AVAILABLE
  BUSY
  OFF_DUTY
  ON_LEAVE
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(PATIENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient                Patient?        @relation("PatientOwner")
  doctorProfile          Doctor?         @relation("DoctorAccount")
  createdAppointments    Appointment[]   @relation("AppointmentCreator")
  patientAccesses        PatientAccess[] @relation("PatientAccessSubject")
  grantedPatientAccesses PatientAccess[] @relation("PatientAccessGrantor")
  revokedTokens          RevokedToken[]
  auditLogs              AuditLog[]
}

model Patient {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String?   @unique @db.Uuid
  patientNumber         String    @unique @db.VarChar(40)
  firstName             String    @db.VarChar(120)
  lastName              String?   @db.VarChar(120)
  dateOfBirth           DateTime? @db.Date
  gender                String?   @db.VarChar(80)
  phone                 String?   @db.VarChar(40)
  email                 String?   @db.VarChar(254)
  address               String?   @db.VarChar(500)
  emergencyContactName  String?   @db.VarChar(160)
  emergencyContactPhone String?   @db.VarChar(40)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user         User?           @relation("PatientOwner", fields: [userId], references: [id], onDelete: SetNull)
  accessGrants PatientAccess[]
  appointments Appointment[]

  @@index([lastName, firstName])
  @@index([email])
}

model PatientAccess {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  userId      String   @db.Uuid
  grantedById String   @db.Uuid
  createdAt   DateTime @default(now())

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user      User    @relation("PatientAccessSubject", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("PatientAccessGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@unique([patientId, userId])
  @@index([userId])
}

model Doctor {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String?            @unique @db.Uuid
  doctorNumber   String             @unique @db.VarChar(40)
  firstName      String             @db.VarChar(120)
  lastName       String             @db.VarChar(120)
  specialization String             @db.VarChar(160)
  department     String             @db.VarChar(120)
  phone          String?            @db.VarChar(40)
  email          String?            @db.VarChar(254)
  availability   DoctorAvailability @default(AVAILABLE)
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user         User?         @relation("DoctorAccount", fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([department])
  @@index([specialization])
  @@index([availability, isActive])
}

model Appointment {
  id             String            @id @default(uuid()) @db.Uuid
  patientId      String            @db.Uuid
  doctorId       String            @db.Uuid
  scheduledStart DateTime          @db.Timestamptz(3)
  scheduledEnd   DateTime          @db.Timestamptz(3)
  status         AppointmentStatus @default(SCHEDULED)
  visitCategory  String            @db.VarChar(120)
  createdBy      String            @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  creator User    @relation("AppointmentCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([patientId, scheduledStart])
  @@index([doctorId, scheduledStart])
  @@index([status, scheduledStart])
}

model RevokedToken {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
